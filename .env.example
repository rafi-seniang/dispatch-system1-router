# Copy to .env. Leave SECRETS_ENV_PATH empty when keys are passed directly in the environment.
SECRETS_ENV_PATH=../../secrets/secrets.env
# jev, gemini, laya, llm or embedding (jev and gemini also load whenever their API keys are set)
TRIAGE_ENGINE=jev
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_CONCURRENT_REQUESTS=8
DEVICE=cuda
LLM_MODEL_ID=Qwen/Qwen3.5-2B
EMBEDDING_MODEL_ID=google/embeddinggemma-2
EMBEDDING_TEMPERATURE=0.02
REVIEW_PROBABILITY_THRESHOLD=0.7
ESCALATE_URGENCY_SCORE=1.5
# Browser origins allowed to call the API (JSON list): the lab frontend in development and preview
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]

# Shared rate limit (docker compose up -d redis). Empty counts per process, local only.
REDIS_URL=redis://localhost:6382/0
RATE_LIMIT_PER_MINUTE=60
# Daily caps on /v1 (0 disables caps locally)
DAILY_REQUESTS_PER_CALLER=0
DAILY_REQUESTS_TOTAL=0
