# Copy to .env. Paths are relative to this folder.
SECRETS_ENV_PATH=../../secrets/secrets.env
# laya, llm or embedding
TRIAGE_ENGINE=laya
DEVICE=cuda
LLM_MODEL_ID=Qwen/Qwen3.5-2B
EMBEDDING_MODEL_ID=google/embeddinggemma-2
EMBEDDING_TEMPERATURE=0.02
REVIEW_PROBABILITY_THRESHOLD=0.7
ESCALATE_URGENCY_SCORE=1.5
# Browser origins allowed to call the API (JSON list): the lab frontend in development and preview
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]
